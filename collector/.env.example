# 바이낸스 본계정 API 키
# 권장: 이 용도로 "읽기 전용" 키를 새로 하나 발급 (Enable Reading 만 체크).
#       매매용 키를 재사용하면 이 PC가 털렸을 때 계좌로 주문까지 가능해짐. 출금 권한은 절대 X
# IP 제한: 이 스크립트를 돌리는 PC의 공인 IP만 허용
# 이 파일을 .env 로 복사해서 값 입력. .env 는 절대 커밋하지 말 것.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 또는: 서버에서 이미 돌고 있는 portfolio_bot 의 키를 그대로 쓰려면 위 두 줄은 비워두고 아래만 지정
# BINANCE_CONFIG_JSON=/home/bot/binance/portfolio_bot/config.json
